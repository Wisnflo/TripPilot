# OpenAI-compatible endpoint. Copy to .env; never commit real credentials.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://your-provider.example/v1
CHINATRAVEL_OPENAI_MODEL=qwen3.8-reasoner

# Adapter defaults; the product CLI also exposes per-run limits.
CHINATRAVEL_REQUEST_TIMEOUT=90
CHINATRAVEL_MAX_ATTEMPTS=2
CHINATRAVEL_RETRY_BACKOFF=2

# Optional adapter token prices per million tokens.
# PRICE_CURRENCY=CNY
# PRICE_INPUT_PER_1M=
# PRICE_OUTPUT_PER_1M=
# Product/evaluation ledger rates are configured in config/v3-pricing.json.
